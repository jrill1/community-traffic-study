# Spot-check runtime state (Mini-local)
spotcheck_state.json

# Re-include the classifier scripts even though traffic_data/ is ignored.
# Each level is un-ignored in turn — git won't enter an excluded directory,
# so we must open traffic_data/ -> license_plates/ -> classifier/ step by step,
# re-ignoring each level's contents, then add back only the .py files.
!traffic_data/
traffic_data/*
!traffic_data/license_plates/
traffic_data/license_plates/*
!traffic_data/license_plates/classifier/
traffic_data/license_plates/classifier/*
!traffic_data/license_plates/classifier/*.py